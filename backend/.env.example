# URL de connexion PostgreSQL en ligne (Neon, Render)
# À renseigner uniquement pour un environnement en ligne
DATABASE_URL=

# Hôte du serveur PostgreSQL local
DB_HOST=localhost

# Port du serveur PostgreSQL local (5432 par défaut)
DB_PORT=5432

# Nom de la base de données locale du projet
DB_NAME=enroll_baby

# Utilisateur PostgreSQL local
DB_USER=postgres

# Mot de passe PostgreSQL local (à renseigner dans ton .env local, jamais ici)
DB_PASSWORD=

# Clé secrète pour signer les tokens JWT (longue et aléatoire)
JWT_SECRET=

# Port d'écoute de l'API
PORT=5000