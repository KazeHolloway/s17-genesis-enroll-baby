# Hôte du serveur PostgreSQL
DB_HOST=localhost

# Port du serveur PostgreSQL (5432 par défaut)
DB_PORT=5432

# Nom de la base de données du projet
DB_NAME=enroll_baby

# Utilisateur PostgreSQL
DB_USER=postgres

# Mot de passe PostgreSQL (à renseigner dans ton .env local, jamais ici)
DB_PASSWORD=

# Clé secrète pour signer les tokens JWT (longue et aléatoire)
JWT_SECRET=

# Port d'écoute de l'API
PORT=5000